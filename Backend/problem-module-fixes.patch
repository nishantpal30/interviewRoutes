--- a/Backend/src/repositories/problem/findAllPublishedProblems.js
+++ b/Backend/src/repositories/problem/findAllPublishedProblems.js
@@ -1,12 +1,25 @@
 import Problem from "../../db/models/problem/problem.js";
 
+const LIST_FIELDS = "title slug difficulty topics accessLevel createdAt";
 
+// Problems visible to learners: published and not soft-deleted.
+export const findAllPublishedProblems = async () => {
+  return Problem.find({
+    isPublished: true,
+    isDeleted: { $ne: true },
+  })
+    .select(LIST_FIELDS)
+    .sort({ title: 1, _id: 1 })
+    .lean();
+};
+
+// Problems created by one user (for creator / admin dashboards).
 export const findProblemsByCreator = async (userId) => {
   return Problem.find({
     createdBy: userId,
     isDeleted: { $ne: true },
   })
-    .select("title slug difficulty topics accessLevel isPublished createdAt")
+    .select(`${LIST_FIELDS} isPublished`)
     .sort({ title: 1, _id: 1 })
     .lean();
 };
diff --git a/Backend/src/repositories/problem/slugTaken.js b/Backend/src/repositories/problem/slugTaken.js
new file mode 100644
index 0000000..a11ae47
--- /dev/null
+++ b/Backend/src/repositories/problem/slugTaken.js
@@ -0,0 +1,11 @@
+import Problem from "../../db/models/problem/problem.js";
+
+// True if another live (not soft-deleted) problem already uses this slug.
+// Pass excludeId when updating so a problem does not clash with itself.
+export const slugTaken = async (slug, excludeId = null) => {
+  const query = { slug, isDeleted: { $ne: true } };
+  if (excludeId) {
+    query._id = { $ne: excludeId };
+  }
+  return Boolean(await Problem.exists(query));
+};
